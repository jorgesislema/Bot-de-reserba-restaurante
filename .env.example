# ===========================================
# RESTAURANT AI PLATFORM - ENVIRONMENT
# ===========================================

# ===========================================
# LLM CONFIGURATION
# ===========================================
OPENROUTER_API_KEY=sk-or-v1-your-key-here
KILO_BASE_URL=https://openrouter.ai/api/v1
KILO_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free

# Fallback models (for failover)
KILO_FALLBACK_MODEL_1=meta-llama/llama-3.1-8b-instruct:free
KILO_FALLBACK_MODEL_2=qwen/qwen-2.5-7b-instruct:free

# ===========================================
# CHANNEL CONFIGURATION
# ===========================================

# WhatsApp Business API
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL=postgresql://user:password@localhost:5432/restaurant_ai
REDIS_URL=redis://localhost:6379

# For development (SQLite)
# DATABASE_URL=sqlite:///./restaurant_ai.db

# ===========================================
# VECTOR DATABASE (pgvector / Qdrant)
# ===========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
VECTOR_DB_TYPE=qdrant  # or pgvector

# ===========================================
# GOOGLE MAPS (Delivery)
# ===========================================
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ===========================================
# GOOGLE CALENDAR (Reservations)
# ===========================================
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# ===========================================
# EMAIL (Alertas)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL=alerts@yourdomain.com

# ===========================================
# RESTAURANT CONFIGURATION
# ===========================================
RESTAURANT_NAME=La Terraza
RESTAURANT_PHONE=+593999999999
RESTAURANT_ADDRESS="Av. Principal 123, Quito"
RESTAURANT_TIMEZONE=America/Guayaquil

# Operating hours
RESTAURANT_OPEN_HOUR=9
RESTAURANT_CLOSE_HOUR=22
RESTAURANT_OPEN_DAY=1  # Monday
RESTAURANT_CLOSE_DAY=7  # Sunday

# ===========================================
# DELIVERY CONFIGURATION
# ===========================================
DELIVERY_ZONE_1_RADIUS_KM=3
DELIVERY_ZONE_1_PRICE=2.00
DELIVERY_ZONE_2_RADIUS_KM=6
DELIVERY_ZONE_2_PRICE=3.50
DELIVERY_ZONE_3_RADIUS_KM=10
DELIVERY_ZONE_3_PRICE=5.00
DELIVERY_BASE_TIME_MINUTES=30

# ===========================================
# AI GOVERNANCE
# ===========================================
AI_CONFIDENCE_THRESHOLD=0.85
AI_MAX_UPSELL_SUGGESTIONS=1
AI_HUMAN_ESCALATION_ENABLED=true
AI_PII_PROTECTION=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_ORDERS_PER_HOUR=10

# ===========================================
# SECURITY
# ===========================================
SECRET_KEY=your-secret-key-change-in-production
API_KEY=your-api-key-for-external-services

# ===========================================
# MONITORING
# ===========================================
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=INFO
ENABLE_METRICS=true

# ===========================================
# DEVELOPMENT
# ===========================================
DEBUG=true
TESTING=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
